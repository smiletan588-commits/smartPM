# ---------- 前端构建阶段 ----------
ARG DOCKER_REGISTRY=m.daocloud.io/docker.io
FROM ${DOCKER_REGISTRY}/library/node:22-alpine AS frontend-builder

ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /frontend
COPY kanban-frontend/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --registry=${NPM_REGISTRY}
COPY kanban-frontend/ ./
RUN npm run build

# ---------- Nginx 运行阶段 ----------
FROM ${DOCKER_REGISTRY}/library/nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-builder /frontend/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
